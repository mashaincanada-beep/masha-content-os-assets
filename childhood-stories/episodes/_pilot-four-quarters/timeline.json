   "t1": 56.655
  },
  {
   "who": "lin",
   "text": "That's a hard moment.",
   "t0": 57.735,
   "t1": 58.97120833333334
  },
  {
   "who": "lin",
   "text": "Want to practise a little? Just ten minutes.",
   "t0": 59.75120833333333,
   "t1": 62.2541875
  },
  {
   "who": "max",
   "text": "...Right now?",
   "t0": 62.634187499999996,
   "t1": 63.641375
  },
  {
   "who": "lin",
   "text": "Right now. Just us.",
   "t0": 64.021375,
   "t1": 65.10972916666667
  },
  {
