   "t1": 20.858
  },
  {
   "who": "max",
   "text": "Just me. Just these, please.",
   "t0": 21.238,
   "t1": 23.793229166666666
  },
  {
   "who": "mr_hassan",
   "text": "That's four twenty-five.",
   "t0": 24.173229166666665,
   "t1": 25.802
  },
  {
   "who": "max",
   "text": "Twenty-five... fifty... seventy-five...",
