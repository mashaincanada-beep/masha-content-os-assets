 "lines": [
  {
   "who": "max",
   "text": "Grandpa's birthday is on Saturday.",
   "t0": 2.9,
   "t1": 5.094625
  },
  {
   "who": "lin",
   "text": "Mm-hm. What do you want to give him?",
