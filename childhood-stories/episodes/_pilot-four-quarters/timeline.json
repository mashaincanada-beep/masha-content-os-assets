   "t1": 7.452562499999999
  },
  {
   "who": "max",
   "text": "His almond cookies. The ones he always buys.",
   "t0": 7.8325625,
   "t1": 11.058895833333333
  },
  {
   "who": "max",
   "text": "But this time... I want to buy them myself.",
   "t0": 11.438895833333333,
   "t1": 14.629145833333332
  },
  {
