   "t1": 31.162145833333334
  },
  {
   "who": "max",
   "text": "a dollar... a dollar... um...",
   "t0": 31.542145833333333,
   "t1": 34.210208333333334
  },
  {
   "who": "mr_hassan",
   "text": "Hey. Take your time, buddy.",
   "t0": 38.4,
   "t1": 41.00033333333333
  },
  {
   "who": "max",
   "text": "It's okay.",
   "t0": 42.28033333333333,
   "t1": 43.45
  },
  {
   "who": "max",
   "text": "I'll come back.",
   "t0": 44.33,
   "t1": 45.46597916666667
  },
  {
   "who": "lin",
   "text": "No cookies?",
   "t0": 51.766666666666666,
   "t1": 52.702979166666665
  },
  {
